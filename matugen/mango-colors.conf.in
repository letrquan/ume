# Written by the shell (services/Wallpaper.qml, template
# ~/.config/quickshell/mine/matugen/mango-colors.conf.in). Don't edit.
# mango 0.18 key names; Noctalia's own Mango template uses the old ones.
root_color=0x{{colors.surface.default.hex_stripped}}ff
border_color=0x{{colors.surface_container_high.default.hex_stripped}}ff
focus_color=0x{{colors.primary.default.hex_stripped}}ff
urgent_color=0x{{colors.error.default.hex_stripped}}ff
maximized_screen_color=0x{{colors.secondary.default.hex_stripped}}ff
scratchpad_color=0x{{colors.tertiary.default.hex_stripped}}ff
global_color=0x{{colors.tertiary.default.hex_stripped}}ff
overlay_color=0x{{colors.primary.default.hex_stripped}}ff
drop_color=0x{{colors.primary.default.hex_stripped}}44
split_color=0x{{colors.tertiary.default.hex_stripped}}ff
tab_bar_decorate_fg_color=0x{{colors.on_surface_variant.default.hex_stripped}}ff
tab_bar_decorate_bg_color=0x{{colors.surface_container.default.hex_stripped}}d9
tab_bar_decorate_focus_fg_color=0x{{colors.on_primary.default.hex_stripped}}ff
tab_bar_decorate_focus_bg_color=0x{{colors.primary.default.hex_stripped}}ff
tab_bar_decorate_border_color=0x{{colors.surface.default.hex_stripped}}ff
